# URL publique exacte de l’application, sans barre oblique finale.
BETTER_AUTH_URL=http://localhost:3000

# Active les valeurs de secours réservées au poste de développement.
# En production, utilisez impérativement la valeur `production`.
TRUSTMAP_ENVIRONMENT=development

# Secret de signature/chiffrement des sessions, 32 octets aléatoires minimum.
# Exemple de génération : npx auth secret
BETTER_AUTH_SECRET=

# Envoi des vérifications, invitations et réinitialisations via Resend.
RESEND_API_KEY=
TRUSTMAP_EMAIL_FROM=MCP TrustMap <security@example.com>

# Développement uniquement : écrit les liens d’e-mail dans la console lorsque
# Resend n’est pas configuré. Ne jamais activer en production.
TRUSTMAP_DEV_EMAIL_LOG=true

# Version de la clé d’enveloppe utilisée pour le registre d’exceptions.
TRUSTMAP_KMS_KEY_ID=cloudflare-secret:v1

# 32 octets aléatoires encodés en base64url. Secret de production.
TRUSTMAP_KMS_MASTER_KEY=

# Optionnel : anciennes clés conservées pendant une rotation.
# Forme : {"cloudflare-secret:v0":"<ancienne-cle-base64url>"}
TRUSTMAP_KMS_PREVIOUS_KEYS=

# Optionnel : passerelle KMS/HSM externe.
TRUSTMAP_KMS_ENDPOINT=
TRUSTMAP_KMS_BEARER_TOKEN=
